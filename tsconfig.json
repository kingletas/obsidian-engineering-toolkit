{
	"compilerOptions": {
		"baseUrl": "./",
		"paths": { "*": ["node_modules/*"] },
		"typeRoots": ["node_modules/@types", "node_modules/obsidian"],
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "es2018",
		"lib": ["DOM", "ES2020"],
		"allowJs": false,
		"noImplicitAny": true,
		"strict": true,
		"strictNullChecks": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"moduleResolution": "node",
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
